# KLYKGO - Hostpoint static hosting
# Compatibility-first configuration for Next.js static export.

DirectoryIndex index.html
Options -MultiViews

# Make sure Hostpoint/Apache serves the generated browser assets with executable MIME types.
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical production URL: HTTPS + non-www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.klykgo\.ch$ [NC]
  RewriteRule ^ https://klykgo.ch%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # During launch, do not allow stale Next.js HTML/JS/CSS to remain cached.
  # Hashed assets can be switched back to long-term caching after deployment is stable.
  <FilesMatch "\.(?:html|js|mjs|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
